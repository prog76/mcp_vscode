{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@vscode-mcp/shared/*": [
                "../shared/src/*"
            ]
        },
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "out",
        "lib": [
            "ES2020",
            "dom"
        ],
        "sourceMap": true,
        "rootDir": "..",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "types": [
            "node",
            "vscode"
        ]
    },
    "exclude": [
        "node_modules",
        ".vscode-test"
    ],
    "include": [
        "src/**/*",
        "../shared/src/**/*"
    ]
}