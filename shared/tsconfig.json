{
    "compilerOptions": {
        "composite": true,
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "out",
        "rootDir": "src",
        "lib": ["ES2020"],
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "typeRoots": ["../extension/node_modules/@types"], "types": ["node"]
    },
    "include": ["src/**/*"]
}
